@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Bienvenido a HelpDesk Pro 2026</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "on-secondary-container": "#00714d",
        "on-background": "#0b1c30",
        "on-tertiary-fixed-variant": "#653e00",
        "on-surface-variant": "#434654",
        "secondary-fixed": "#6ffbbe",
        "on-surface": "#0b1c30",
        "surface-container-highest": "#d3e4fe",
        "inverse-on-surface": "#eaf1ff",
        "inverse-primary": "#b2c5ff",
        "outline-variant": "#c3c6d6",
        "surface-container-high": "#dce9ff",
        "on-tertiary-container": "#ffc988",
        "secondary-fixed-dim": "#4edea3",
        "surface-dim": "#cbdbf5",
        "on-error-container": "#93000a",
        "on-primary-fixed": "#001848",
        "secondary-container": "#6cf8bb",
        "on-tertiary-fixed": "#2a1700",
        "error-container": "#ffdad6",
        "surface-container": "#e5eeff",
        "surface-tint": "#0c56d0",
        "on-tertiary": "#ffffff",
        "on-primary": "#ffffff",
        "on-secondary-fixed": "#002113",
        "on-primary-fixed-variant": "#0040a2",
        "surface-container-low": "#eff4ff",
        "primary-fixed-dim": "#b2c5ff",
        "surface": "#f8f9ff",
        "on-error": "#ffffff",
        "inverse-surface": "#213145",
        "tertiary-container": "#805000",
        "surface-container-lowest": "#ffffff",
        "primary-container": "#0052cc",
        "surface-variant": "#d3e4fe",
        "on-secondary": "#ffffff",
        "tertiary-fixed": "#ffddb8",
        "error": "#ba1a1a",
        "on-primary-container": "#c4d2ff",
        "surface-bright": "#f8f9ff",
        "background": "#f8f9ff",
        "secondary": "#006c49",
        "primary": "#003d9b",
        "outline": "#737685",
        "tertiary": "#603b00",
        "tertiary-fixed-dim": "#ffb95f",
        "on-secondary-fixed-variant": "#005236",
        "primary-fixed": "#dae2ff"
        },
        "borderRadius": {
        "DEFAULT": "0.125rem",
        "lg": "0.25rem",
        "xl": "0.5rem",
        "full": "0.75rem"
        },
        "spacing": {
        "sidebar-width": "260px",
        "sidebar-collapsed": "64px",
        "unit": "4px",
        "gutter": "16px",
        "container-padding": "24px"
        },
        "fontFamily": {
        "body-lg": ["Inter"],
        "label-sm": ["Inter"],
        "headline-lg": ["Inter"],
        "body-md": ["Inter"],
        "display": ["Inter"],
        "headline-md": ["Inter"],
        "label-md": ["Inter"]
        },
        "fontSize": {
        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
        "label-sm": ["11px", { "lineHeight": "14px", "fontWeight": "500" }],
        "headline-lg": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
        "display": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
        "headline-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }]
        }
        }
        }
        }
    </script>
    <style>
        .glass-panel {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 8px 32px 0 rgba(0, 61, 155, 0.05);
        }
    </style>
</head>
<body class="bg-surface-container-low text-on-surface font-body-md min-h-screen flex flex-col items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%230b1c30\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    <main class="w-full max-w-2xl px-container-padding flex-grow flex flex-col justify-center items-center z-10 relative">
        <div class="glass-panel rounded-xl p-8 md:p-12 w-full flex flex-col items-center text-center animate-fade-in-up">
            <div class="w-32 h-32 md:w-40 md:h-40 mb-8 flex items-center justify-center">
                <img alt="HelpDesk Pro 2026 Logo" class="w-full h-full object-contain drop-shadow-sm" 
                    src="~/lib/screen.png" 
                />
            </div>
            <h1 class="font-display text-display text-on-surface mb-4">
                Bienvenido a HelpDesk Pro 2026
            </h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant mb-10 max-w-lg">
                La plataforma inteligente para la gestión de soporte técnico y atención al cliente.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto justify-center">

                <!-- Iniciar Sesión -->
                <a asp-controller="Account"
                   asp-action="Login"
                   class="bg-primary text-on-primary px-8 py-3 rounded font-label-md text-label-md hover:bg-primary-fixed-variant transition-colors duration-200 flex items-center justify-center gap-2 w-full sm:w-auto min-w-[160px] shadow-sm">

                    <span>Iniciar Sesión</span>

                    <span class="material-symbols-outlined text-[18px]">
                        login
                    </span>

                </a>

                <!-- Crear Cuenta -->
                <a asp-controller="Account"
                   asp-action="Register"
                   class="bg-transparent border border-outline text-on-surface px-8 py-3 rounded font-label-md text-label-md hover:bg-surface-container-high transition-colors duration-200 flex items-center justify-center gap-2 w-full sm:w-auto min-w-[160px]">

                    <span>Crear Cuenta</span>

                    <span class="material-symbols-outlined text-[18px]">
                        person_add
                    </span>

                </a>

            </div>
        </div>
    </main>
</body>
</html>
