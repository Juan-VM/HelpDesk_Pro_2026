@{
    ViewData["Title"] = "Iniciar sesión";
}

@model HelpDesk_Pro_2026.Models.LoginViewModel;

<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "on-secondary-fixed": "#002113",
        "background": "#f8f9ff",
        "surface-container-highest": "#d3e4fe",
        "surface-tint": "#0c56d0",
        "tertiary-fixed": "#ffddb8",
        "surface-bright": "#f8f9ff",
        "surface-container": "#e5eeff",
        "primary-fixed-dim": "#b2c5ff",
        "surface-variant": "#d3e4fe",
        "on-error-container": "#93000a",
        "surface-container-low": "#eff4ff",
        "on-primary-fixed": "#001848",
        "on-surface": "#0b1c30",
        "on-primary": "#ffffff",
        "surface-container-lowest": "#ffffff",
        "on-secondary-fixed-variant": "#005236",
        "secondary-fixed-dim": "#4edea3",
        "surface": "#f8f9ff",
        "on-secondary-container": "#00714d",
        "on-tertiary": "#ffffff",
        "on-tertiary-container": "#ffc988",
        "surface-container-high": "#dce9ff",
        "on-surface-variant": "#434654",
        "on-error": "#ffffff",
        "error-container": "#ffdad6",
        "on-tertiary-fixed": "#2a1700",
        "outline-variant": "#c3c6d6",
        "secondary-fixed": "#6ffbbe",
        "on-secondary": "#ffffff",
        "inverse-on-surface": "#eaf1ff",
        "tertiary": "#603b00",
        "on-primary-container": "#c4d2ff",
        "inverse-surface": "#213145",
        "outline": "#737685",
        "primary-container": "#0052cc",
        "surface-dim": "#cbdbf5",
        "primary": "#003d9b",
        "tertiary-container": "#805000",
        "secondary-container": "#6cf8bb",
        "on-primary-fixed-variant": "#0040a2",
        "tertiary-fixed-dim": "#ffb95f",
        "inverse-primary": "#b2c5ff",
        "secondary": "#006c49",
        "on-background": "#0b1c30",
        "on-tertiary-fixed-variant": "#653e00",
        "error": "#ba1a1a",
        "primary-fixed": "#dae2ff"
        },
        "borderRadius": {
        "DEFAULT": "0.125rem",
        "lg": "0.25rem",
        "xl": "0.5rem",
        "full": "0.75rem"
        },
        "spacing": {
        "unit": "4px",
        "container-padding": "24px",
        "sidebar-collapsed": "64px",
        "gutter": "16px",
        "sidebar-width": "260px"
        },
        "fontFamily": {
        "body-lg": [
        "Inter"
        ],
        "label-sm": [
        "Inter"
        ],
        "display": [
        "Inter"
        ],
        "body-md": [
        "Inter"
        ],
        "headline-lg": [
        "Inter"
        ],
        "label-md": [
        "Inter"
        ],
        "headline-md": [
        "Inter"
        ]
        },
        "fontSize": {
        "body-lg": [
        "16px",
        {
        "lineHeight": "24px",
        "fontWeight": "400"
        }
        ],
        "label-sm": [
        "11px",
        {
        "lineHeight": "14px",
        "fontWeight": "500"
        }
        ],
        "display": [
        "36px",
        {
        "lineHeight": "44px",
        "letterSpacing": "-0.02em",
        "fontWeight": "700"
        }
        ],
        "body-md": [
        "14px",
        {
        "lineHeight": "20px",
        "fontWeight": "400"
        }
        ],
        "headline-lg": [
        "24px",
        {
        "lineHeight": "32px",
        "letterSpacing": "-0.01em",
        "fontWeight": "600"
        }
        ],
        "label-md": [
        "12px",
        {
        "lineHeight": "16px",
        "letterSpacing": "0.05em",
        "fontWeight": "600"
        }
        ],
        "headline-md": [
        "20px",
        {
        "lineHeight": "28px",
        "fontWeight": "600"
        }
        ]
        }
        },
        },
        }
    </script>
</head>
<body class="bg-background min-h-screen flex items-center justify-center p-10 font-body-md text-body-md text-on-background">
    <!-- Design Canvas: Centered Login Form -->
    <main class="w-full max-w-3xl bg-surface-container-lowest border border-outline-variant rounded-2xl shadow-xl overflow-hidden">
        <!-- Header -->
        <div class="px-12 pt-14 pb-10 text-center">
            <div class="flex justify-center mb-8">
                <img alt="HelpDesk Pro Logo" class="h-32 w-32 object-contain rounded-lg" src="~/lib/screen.png">
            </div>
            <h1 class="text-4xl font-bold text-on-surface mb-4">HelpDesk Pro 2026</h1>
            <p class="text-lg text-on-surface-variant">Inicie sesión en su portal de soporte.</p>
        </div>
        <!-- Form -->
        <div class="px-12 pb-12">

            @if (ViewBag.Error != null)
            {
                <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-red-700">
                    @ViewBag.Error
                </div>
            }

            <div asp-validation-summary="ModelOnly"
                 class="mb-4 text-red-600 text-sm">
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  class="space-y-8">

                <!-- Email Field -->
                <div>
                    <label class="block text-base font-medium text-on-surface-variant mb-2" for="email">Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-outline text-[24px]" data-icon="mail">mail</span>
                        </div>
                        <input asp-for="Email"
                            class="block w-full pl-12 pr-4 py-3 border border-outline-variant rounded-lg bg-surface-container-lowest text-on-surface focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container text-base transition-shadow"
                            placeholder="nombre@empresa.com" required type="email">
                    </div>
                </div>
                <!-- Password Field -->
                <div>
                    <label class="block text-base font-medium text-on-surface-variant mb-2" for="password">Contraseña</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-outline text-[24px]" data-icon="lock">lock</span>
                        </div>
                        <input asp-for="Password"
                            type="password" class="block w-full pl-12 pr-4 py-3 border border-outline-variant rounded-lg bg-surface-container-lowest text-on-surface focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container text-base transition-shadow"
                            placeholder="••••••••" required>
                    </div>
                </div>
                <!-- Submit Button -->
                <div class="pt-4">
                    <button class="w-full flex justify-center py-3 px-6 border border-transparent rounded-lg shadow-md text-base font-semibold text-on-primary bg-[#0052cc] hover:bg-primary transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#0052cc]" type="submit">
                        Iniciar sesión
                    </button>
                </div>
            </form>
        </div>
        <!-- Footer -->
        <div class="px-12 py-6 bg-surface-container-low border-t border-outline-variant text-center">
            <a asp-controller="Account"
               asp-action="Register"
               class="text-base text-primary font-medium hover:text-surface-tint transition-colors">
                ¿No tienes cuenta? Regístrate
            </a>
        </div>
    </main>
</body>
</html>