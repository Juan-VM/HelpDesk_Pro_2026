@model HelpDesk_Pro_2026.Models.EditTicketViewModel

@{
    ViewData["Title"] = "Detalle de Ticket";
    Layout = "_DashboardLayout";

    string userRole = ViewBag.UserRole as string ?? "EMPLEADO";
    Guid currentUserId = ViewBag.CurrentUserId != null ? (Guid)ViewBag.CurrentUserId : Guid.Empty;
    var ticket = ViewBag.Ticket as HelpDesk_Pro_2026.Models.Ticket;
    var comments = ViewBag.Comments as List<HelpDesk_Pro_2026.Models.Comment> ?? new List<HelpDesk_Pro_2026.Models.Comment>();

    int currentStateId = ticket?.StateId ?? 1;

    // Form fields are locked if the user is Support or an Employee viewing a non-pending ticket
    bool isReadOnly = (userRole == "SOPORTE") || (userRole == "EMPLEADO" && currentStateId != 1);
}

<div class="p-6 max-w-5xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <a asp-action="Index" class="text-sm font-medium text-on-surface-variant hover:text-primary inline-flex items-center mb-2 gap-1">
                <span class="material-symbols-outlined text-sm">arrow_back</span> Volver a la lista
            </a>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-on-surface">Ticket @Model.TicketCode</h1>
                <span class="px-3 py-1 rounded-md text-xs font-semibold bg-surface-container-high text-primary border border-outline-variant">
                    @(ticket?.State?.Name ?? "PENDIENTE")
                </span>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 text-sm text-green-800 rounded-lg bg-green-50 border border-green-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">check_circle</span>
            <span><strong class="font-semibold">¡Éxito!</strong> @TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">error</span>
            <span><strong class="font-semibold">Error:</strong> @TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- SUPPORT STATUS CONTROL PANEL -->
    @if (userRole == "SOPORTE" || userRole == "SUPERUSUARIO")
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant p-6">
            <h2 class="text-base font-bold text-on-surface mb-2 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">tune</span> Control de Estado (Soporte Técnico)
            </h2>
            <p class="text-xs text-on-surface-variant mb-4">
                Avance el estado del ticket de forma controlada o márquelo como cancelado.
            </p>

            <div class="flex flex-wrap items-center gap-3">
                @if (currentStateId == 1) // PENDIENTE -> EN REVISIÓN (2) or CANCELADO (5)
                {
                    <form asp-action="UpdateState" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <input type="hidden" name="newStateId" value="2" />
                        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs rounded-lg transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-outlined text-base">search</span> Pasar a En Revisión
                        </button>
                    </form>
                    <form asp-action="UpdateState" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <input type="hidden" name="newStateId" value="5" />
                        <button type="submit" onclick="return confirm('¿Está seguro de cancelar este ticket?');" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium text-xs rounded-lg transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-outlined text-base">cancel</span> Cancelar Ticket
                        </button>
                    </form>
                }
                else if (currentStateId == 2) // EN REVISIÓN -> EN PROGRESO (3) or CANCELADO (5)
                {
                    <form asp-action="UpdateState" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <input type="hidden" name="newStateId" value="3" />
                        <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-medium text-xs rounded-lg transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-outlined text-base">engineering</span> Pasar a En Progreso
                        </button>
                    </form>
                    <form asp-action="UpdateState" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <input type="hidden" name="newStateId" value="5" />
                        <button type="submit" onclick="return confirm('¿Está seguro de cancelar este ticket?');" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium text-xs rounded-lg transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-outlined text-base">cancel</span> Cancelar Ticket
                        </button>
                    </form>
                }
                else if (currentStateId == 3) // EN PROGRESO -> FINALIZADO (4) or CANCELADO (5)
                {
                    <form asp-action="UpdateState" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <input type="hidden" name="newStateId" value="4" />
                        <button type="submit" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium text-xs rounded-lg transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-outlined text-base">check_circle</span> Marcar como Finalizado
                        </button>
                    </form>
                    <form asp-action="UpdateState" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <input type="hidden" name="newStateId" value="5" />
                        <button type="submit" onclick="return confirm('¿Está seguro de cancelar este ticket?');" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium text-xs rounded-lg transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                            <span class="material-symbols-outlined text-base">cancel</span> Cancelar Ticket
                        </button>
                    </form>
                }
                else
                {
                    <span class="text-xs text-on-surface-variant italic">
                        Este ticket ha sido <strong>@(currentStateId == 4 ? "Finalizado" : "Cancelado")</strong> y no admite cambios de estado adicionales.
                    </span>
                }
            </div>
        </div>
    }

    <!-- TICKET DATA FORM -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant p-6">
        @if (isReadOnly && userRole == "EMPLEADO")
        {
            <div class="mb-4 p-3 bg-amber-50 border border-amber-200 text-amber-800 text-xs rounded-lg flex items-center gap-2">
                <span class="material-symbols-outlined text-base">lock</span>
                Este ticket está en atención. Los campos se encuentran bloqueados para edición.
            </div>
        }

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TicketId" />
            <input type="hidden" asp-for="TicketCode" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Sistema -->
                <div>
                    <label asp-for="SystemId" class="block text-sm font-medium text-on-surface mb-1">Sistema Afectado *</label>
                    <select asp-for="SystemId" asp-items="ViewBag.Systems" disabled="@(isReadOnly ? "disabled" : null)" class="w-full rounded-lg border-outline-variant border p-2.5 text-sm bg-surface focus:ring-2 focus:ring-primary focus:outline-none disabled:bg-surface-container-low disabled:text-on-surface-variant"></select>
                    <span asp-validation-for="SystemId" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <!-- Categoría -->
                <div>
                    <label asp-for="CategoryId" class="block text-sm font-medium text-on-surface mb-1">Categoría *</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" disabled="@(isReadOnly ? "disabled" : null)" class="w-full rounded-lg border-outline-variant border p-2.5 text-sm bg-surface focus:ring-2 focus:ring-primary focus:outline-none disabled:bg-surface-container-low disabled:text-on-surface-variant"></select>
                    <span asp-validation-for="CategoryId" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <!-- Prioridad -->
                <div>
                    <label asp-for="PriorityId" class="block text-sm font-medium text-on-surface mb-1">Prioridad *</label>
                    <select asp-for="PriorityId" asp-items="ViewBag.Priorities" disabled="@(isReadOnly ? "disabled" : null)" class="w-full rounded-lg border-outline-variant border p-2.5 text-sm bg-surface focus:ring-2 focus:ring-primary focus:outline-none disabled:bg-surface-container-low disabled:text-on-surface-variant"></select>
                    <span asp-validation-for="PriorityId" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <!-- Nivel de Riesgo -->
                <div>
                    <label asp-for="RiskId" class="block text-sm font-medium text-on-surface mb-1">Nivel de Riesgo *</label>
                    <select asp-for="RiskId" asp-items="ViewBag.RiskLevels" disabled="@(isReadOnly ? "disabled" : null)" class="w-full rounded-lg border-outline-variant border p-2.5 text-sm bg-surface focus:ring-2 focus:ring-primary focus:outline-none disabled:bg-surface-container-low disabled:text-on-surface-variant"></select>
                    <span asp-validation-for="RiskId" class="text-xs text-red-600 mt-1 block"></span>
                </div>
            </div>

            <!-- Asunto -->
            <div>
                <label asp-for="Subject" class="block text-sm font-medium text-on-surface mb-1">Asunto / Título Resumido *</label>
                <input asp-for="Subject" readonly="@(isReadOnly ? "readonly" : null)" class="w-full rounded-lg border-outline-variant border p-2.5 text-sm bg-surface focus:ring-2 focus:ring-primary focus:outline-none readonly:bg-surface-container-low readonly:text-on-surface-variant" />
                <span asp-validation-for="Subject" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <!-- Descripción -->
            <div>
                <label asp-for="Description" class="block text-sm font-medium text-on-surface mb-1">Descripción Detallada *</label>
                <textarea asp-for="Description" rows="4" readonly="@(isReadOnly ? "readonly" : null)" class="w-full rounded-lg border-outline-variant border p-2.5 text-sm bg-surface focus:ring-2 focus:ring-primary focus:outline-none readonly:bg-surface-container-low readonly:text-on-surface-variant"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <!-- Justificación -->
            <div>
                <label asp-for="Justification" class="block text-sm font-medium text-on-surface mb-1">Justificación</label>
                <textarea asp-for="Justification" rows="2" readonly="@(isReadOnly ? "readonly" : null)" class="w-full rounded-lg border-outline-variant border p-2.5 text-sm bg-surface focus:ring-2 focus:ring-primary focus:outline-none readonly:bg-surface-container-low readonly:text-on-surface-variant"></textarea>
            </div>

            <!-- Archivos Adjuntos -->
            <div class="p-4 bg-surface rounded-lg border border-outline-variant space-y-4">
                <label class="block text-sm font-semibold text-on-surface">Archivos Adjuntos</label>

                <div id="attachments-container" class="space-y-2">
                    @if (Model.ExistingAttachments != null && Model.ExistingAttachments.Any())
                    {
                        @foreach (var file in Model.ExistingAttachments)
                        {
                            <div id="attachment-row-@file.AttachmentId" class="flex items-center justify-between p-3 bg-surface-container-low rounded-lg border border-outline-variant">
                                <a href="@file.FileUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline truncate">
                                    <span class="material-symbols-outlined text-base">attach_file</span>
                                    @file.FileName
                                </a>
                                @if (!isReadOnly)
                                {
                                    <button type="button" onclick="deleteAttachment(@file.AttachmentId)" class="inline-flex items-center gap-1 text-xs text-red-600 hover:text-red-800 font-medium cursor-pointer px-2.5 py-1.5 rounded-lg bg-red-50 border border-red-200 hover:bg-red-100 transition-colors">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                        Eliminar
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p id="no-attachments-msg" class="text-xs text-on-surface-variant italic">Este ticket no tiene ningún archivo adjunto actualmente.</p>
                    }
                </div>

                @if (!isReadOnly)
                {
                    <div>
                        <label asp-for="NewAttachments" class="block text-xs font-medium text-on-surface-variant mb-1">
                            Agregar nuevos archivos:
                        </label>
                        <input asp-for="NewAttachments" type="file" multiple class="w-full rounded-lg border-outline-variant border p-2 text-sm bg-surface-container-lowest text-on-surface-variant focus:ring-2 focus:ring-primary focus:outline-none file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-on-primary hover:file:opacity-90 cursor-pointer" />
                    </div>
                }
            </div>

            <!-- Form Buttons -->
            @if (!isReadOnly)
            {
                <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant">
                    <a asp-action="Index" class="px-5 py-2.5 bg-surface hover:bg-surface-variant text-on-surface-variant text-sm font-medium rounded-lg transition-colors">Cancelar</a>
                    <button type="submit" class="px-5 py-2.5 bg-primary hover:opacity-90 text-on-primary font-medium text-sm rounded-lg shadow-sm transition-opacity cursor-pointer">
                        Actualizar Ticket
                    </button>
                </div>
            }
        </form>
    </div>

    <!-- COMMENTS SECTION -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant p-6 space-y-6">
        <h2 class="text-lg font-bold text-on-surface flex items-center gap-2 border-b border-outline-variant pb-3">
            <span class="material-symbols-outlined text-primary">chat</span> Comentarios e Historial
        </h2>

        <!-- Comment Feed -->
        <div class="space-y-4">
            @if (!comments.Any())
            {
                <p class="text-xs text-on-surface-variant italic text-center py-4">No hay comentarios aún en este ticket.</p>
            }
            else
            {
                @foreach (var comment in comments)
                {
                    <div class="flex items-start gap-3 p-4 bg-surface-container-low rounded-xl border border-outline-variant">
                        <!-- Avatar / Photo -->
                        @if (!string.IsNullOrEmpty(comment.User?.PhotoUrl))
                        {
                            <img src="@comment.User.PhotoUrl" alt="Avatar" class="w-9 h-9 rounded-full object-cover border border-outline-variant shrink-0 mt-0.5" />
                        }
                        else
                        {
                            <div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs border border-primary/20 shrink-0 mt-0.5">
                                @(comment.User?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                        }

                        <!-- Comment Content -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between mb-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-semibold text-on-surface">@(comment.User?.FullName ?? "Usuario")</span>
                                    <span class="text-xs text-outline">@comment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>

                                <!-- Comment Actions (Owner Only) -->
                                @if (comment.UserId == currentUserId)
                                {
                                    <div class="flex items-center gap-2">
                                        <button type="button" onclick="toggleEditComment(@comment.CommentId)" class="text-xs text-primary hover:underline font-medium cursor-pointer">
                                            Editar
                                        </button>
                                        <form asp-action="DeleteComment" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="commentId" value="@comment.CommentId" />
                                            <input type="hidden" name="ticketId" value="@Model.TicketId" />
                                            <button type="submit" onclick="return confirm('¿Desea borrar este comentario?');" class="text-xs text-red-600 hover:underline font-medium cursor-pointer">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <!-- Comment View Body -->
                            <p id="comment-text-@comment.CommentId" class="text-xs text-on-surface-variant whitespace-pre-line leading-relaxed">@comment.CommentText</p>

                            <!-- Comment Edit Inline Form -->
                            @if (comment.UserId == currentUserId)
                            {
                                <form id="edit-form-@comment.CommentId" asp-action="UpdateComment" method="post" class="hidden mt-3 space-y-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="commentId" value="@comment.CommentId" />
                                    <input type="hidden" name="ticketId" value="@Model.TicketId" />
                                    <textarea name="commentText" rows="2" class="w-full rounded-lg border-outline-variant border p-2 text-xs bg-surface focus:ring-2 focus:ring-primary focus:outline-none" required>@comment.CommentText</textarea>
                                    <div class="flex justify-end gap-2">
                                        <button type="button" onclick="toggleEditComment(@comment.CommentId)" class="px-3 py-1 text-xs text-on-surface-variant hover:bg-surface-variant rounded-md">Cancelar</button>
                                        <button type="submit" class="px-3 py-1 text-xs bg-primary text-on-primary rounded-md font-medium">Guardar</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Add New Comment -->
        <form asp-action="AddComment" method="post" class="pt-4 border-t border-outline-variant space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ticketId" value="@Model.TicketId" />
            <label class="block text-xs font-semibold text-on-surface">Agregar un comentario</label>
            <textarea name="commentText" rows="3" placeholder="Escriba sus observaciones o actualización aquí..." class="w-full rounded-lg border-outline-variant border p-3 text-xs bg-surface focus:ring-2 focus:ring-primary focus:outline-none" required></textarea>
            <div class="flex justify-end">
                <button type="submit" class="px-4 py-2 bg-primary hover:opacity-90 text-on-primary font-medium text-xs rounded-lg shadow-sm transition-opacity inline-flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-base">send</span> Publicar Comentario
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleEditComment(commentId) {
            const textElem = document.getElementById('comment-text-' + commentId);
            const formElem = document.getElementById('edit-form-' + commentId);

            if (formElem) {
                formElem.classList.toggle('hidden');
            }
            if (textElem) {
                textElem.classList.toggle('hidden');
            }
        }

        async function deleteAttachment(attachmentId) {
            if (!confirm("¿Está seguro de que desea eliminar este archivo? Se borrará inmediatamente del servidor.")) {
                return;
            }

            try {
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenElement ? tokenElement.value : '';

                const response = await fetch('/Tickets/DeleteAttachment?attachmentId=' + attachmentId, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();
                if (data.success) {
                    const row = document.getElementById('attachment-row-' + attachmentId);
                    if (row) {
                        row.remove();
                    }

                    const container = document.getElementById('attachments-container');
                    if (!container.querySelector('[id^="attachment-row-"]')) {
                        container.innerHTML = '<p id="no-attachments-msg" class="text-xs text-on-surface-variant italic">Este ticket no tiene ningún archivo adjunto actualmente.</p>';
                    }
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                alert('Ocurrió un error al intentar borrar el archivo.');
            }
        }
    </script>
}